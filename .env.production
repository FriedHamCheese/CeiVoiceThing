# --- OCI Deployment Configuration ---
# The domain name or IP address of your Oracle VM
DOMAIN_OR_IP=your_oracle_vm_ip_or_domain

# URLs (Constructed using DOMAIN_OR_IP usually)
# For backend CORS and email notifications
FRONTEND_URL=http://your_oracle_vm_ip_or_domain:5501
# For frontend build (where it will fetch from)
VITE_API_URL=http://your_oracle_vm_ip_or_domain:5001

# --- Database Credentials ---
DATABASE_HOST=database
DATABASE_NAME=ceivoice
DATABASE_USERNAME=ceivoice_user
DATABASE_PASSWORD=your_secure_database_password
DATABASE_ROOT_PASSWORD=your_secure_root_password

# --- Backend Configuration ---
SESSION_SECRET=CEI_voice_Session_secret
SERVER_PORT=5001
FRONTEND_PORT=5501
NODE_ENV=production

# --- Authentication ---
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM Integration ---
# LLM_PROVIDER: OPENAI or ORACLE
LLM_PROVIDER=
ORACLE_URL=
ORACLE_MODEL=

# --- Classification Server ---
ORACLE_USER=
ORACLE_PASS=
OPENAI_API_KEY=
SAFTY_FALLBACK_EMAIL=admin@example.com

# --- Email Notification (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
